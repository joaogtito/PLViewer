{
  "name": "plviewer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icones": "pwa-assets-generator",
    "build:android": "tsc -b && vite build --mode capacitor && cap sync android",
